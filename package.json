{
  "name": "nineteen_bot",
  "version": "1.0.0",
  "description": "",
  "main": "src/main.ts",
  "scripts": {
    "build": "npx tsc && npx tsc-alias",
    "start": "npm run build && node ./dist/main.js lang=zh_cn",
    "dev": "npm run build && node ./dist/main.js lang=zh_cn",
    "panel": "npm run build && node ./dist/panel/createPanel.js",
    "inspect": "npm run build && node --inspect=0.0.0.0:9229 ./dist/main.js lang=zh_cn",
    "fix": "node ./src/Fix/main.js",
    "test": "npm run build && node ./dist/test/createBot.js --noPanel lang=zh_cn",
    "fast": "npm run build && node ./dist/test/createBot.js lang=zh_cn"
  },
  "author": "TAOtxi",
  "type": "module",
  "license": "ISC",
  "dependencies": {
    "cycle": "^1.0.3",
    "fuzzy": "^0.1.3",
    "ink": "^7.1.1",
    "inquirer": "^13.3.2",
    "mineflayer": "^4.37.1",
    "prismarine-viewer": "^1.33.0",
    "react": "^19.2.8",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2"
  }
}
